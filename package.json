{
  "name": "focus-tube-blocker",
  "version": "3.1.8",
  "author": "Manuel Adolfo Deño de los Santos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "version:sync": "node scripts/sync-version.js",
    "version:patch": "pnpm version patch --no-git-tag-version && pnpm run version:sync",
    "version:minor": "pnpm version minor --no-git-tag-version && pnpm run version:sync",
    "version:major": "pnpm version major --no-git-tag-version && pnpm run version:sync",
    "build": "pnpm run version:sync && vite build && vite build --config vite.content.config.ts && node scripts/copy-manifest.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/tests",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:ui": "playwright test --ui",
    "db:check": "node scripts/print-db-check.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "encoding:check": "node scripts/check-encoding.js",
    "encoding:fix": "node scripts/fix-encoding.js"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@types/chrome": "^0.0.244",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.52",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@playwright/test": "^1.51.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.45",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.5.4",
    "vite": "^5.0.12",
    "vitest": "^1.2.2"
  }
}
