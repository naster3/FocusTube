{
  "manifest_version": 3,
  "name": "FocusTube Blocker",
  "version": "3.0.1",
  "author": "Manuel Adolfo Deño de los Santos",
  "description": "Bloquea YouTube por horarios con whitelist y modo estricto.",
  "permissions": [
    "permissions",
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_title": "FocusTube Blocker",
    "default_popup": "src/ui/popup/index.html"
  },
  "options_page": "src/ui/options/index.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/FT_icon_16x16.png",
    "32": "icons/FT_icon_32x32.png",
    "48": "icons/FT_icon_48x48.png",
    "128": "icons/FT_icon_128x128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/blocked/index.html",
        "blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
